{
  "name": "Zen Berry",
  "short_name": "ZenBerry",
  "description": "A mindful productivity app with Pomodoro timer, task management, and AI-powered insights",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#FEFCF3",
  "theme_color": "#86A788",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.svg",
      "sizes": "180x180",
      "type": "image/svg+xml",
      "purpose": "apple-touch-icon"
    }
  ]
}
